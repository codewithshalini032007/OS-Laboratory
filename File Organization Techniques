#include <stdio.h>
#include <stdlib.h>

struct Student
{
    int roll;
    char name[50];
    float mark;
};

int main()
{
    FILE *fp;
    struct Student s;
    int n;

    printf("Enter number of students: ");
    scanf("%d", &n);

    fp = fopen("students.dat", "wb");

    if (fp == NULL)
    {
        printf("File opening failed.\n");
        return 1;
    }

    for (int i = 0; i < n; i++)
    {
        printf("\nEnter Roll Number: ");
        scanf("%d", &s.roll);

        printf("Enter Name: ");
        scanf("%s", s.name);

        printf("Enter Mark: ");
        scanf("%f", &s.mark);

        fwrite(&s, sizeof(s), 1, fp);
    }

    fclose(fp);

    fp = fopen("students.dat", "rb");

    if (fp == NULL)
    {
        printf("File opening failed.\n");
        return 1;
    }

    printf("\nStudent Records:\n");
    printf("Roll\tName\tMark\n");

    while (fread(&s, sizeof(s), 1, fp))
    {
        printf("%d\t%s\t%.2f\n", s.roll, s.name, s.mark);
    }

    fclose(fp);

    return 0;
}
